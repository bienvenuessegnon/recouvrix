# GEMINI_API_KEY: optional — enables AI draft / dashboard advisor.
GEMINI_API_KEY=

# APP_URL: optional public URL of the deployment.
APP_URL=

# Required for demo accounts (admin@recouvrix.demo / gestionnaire@recouvrix.demo).
# Without both values the API refuses login (no public password bootstrap).
DEMO_ADMIN_PASSWORD=
DEMO_MANAGER_PASSWORD=

SESSION_TTL_MINUTES=480

# Docker Compose only (never commit real values)
# POSTGRES_PASSWORD=
# SESSION_SECRET=
