# GEMINI_API_KEY: optional — enables AI draft / dashboard advisor.
GEMINI_API_KEY=

# APP_URL: optional public URL of the deployment.
APP_URL=

# Frontend Vercel : origines autorisées (séparées par des virgules).
# CORS_ORIGINS=https://recouvrix.vercel.app

# Build frontend Vercel — pointe vers l’API Render.
# VITE_API_BASE_URL=https://recouvrix-saas.onrender.com

# Demo accounts (admin@recouvrix.demo / gestionnaire@recouvrix.demo).
# Required to enable those seeded accounts. Leave empty to rely on self-signup.
DEMO_ADMIN_PASSWORD=
DEMO_MANAGER_PASSWORD=

# Public self-signup for the hackathon demo (default: enabled).
ALLOW_PUBLIC_REGISTER=true

# SQLite file directory for demo users/sessions (default: ./data).
# DATA_DIR=

SESSION_TTL_MINUTES=480

# Docker Compose only (never commit real values)
# POSTGRES_PASSWORD=
# SESSION_SECRET=
