# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio / Cursor injects this at runtime from user secrets when configured.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted (optional locally).
APP_URL=

# Authentification Recouvrix
# Si les deux mots de passe sont définis, les comptes démo sont prêts au démarrage.
# Sinon, l'écran de configuration initiale (bootstrap) demande de les créer.
DEMO_ADMIN_PASSWORD=
DEMO_MANAGER_PASSWORD=
SESSION_TTL_MINUTES=480

# Docker Compose only (never commit real values)
# POSTGRES_PASSWORD=
# SESSION_SECRET=
